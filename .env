# Скопируйте этот файл в .env и заполните значениями из вашего проекта Supabase.
# На хостинге (Vercel/Netlify) те же переменные задаются в настройках проекта
# ("Environment Variables"), .env туда не заливается (он в .gitignore).

# Supabase → Project Settings → Data API
NUXT_SUPABASE_URL=https://hdfhiccrtabsjyuhttbg.supabase.co

# Supabase → Project Settings → API Keys → service_role (секретный, НЕ anon-ключ!)
NUXT_SUPABASE_SERVICE_KEY=sb_secret_ephAC3MiaLDQBdJyqOJo2g_0JEno4Xf

# Имя бакета в Supabase Storage для загруженных картинок (создать заранее, публичный доступ на чтение)
NUXT_SUPABASE_BUCKET=museumData

# Пароль для входа в /admin
NUXT_ADMIN_PASSWORD=6v6UY0mvnRNwHlKX

# Любая длинная случайная строка — секрет для подписи cookie-сессии админки.
# Например, сгенерировать: openssl rand -hex 32
NUXT_SESSION_SECRET=o80eca156a5430f46704f441f544dc9f419504297ca612e3847b03cd09633ea63
